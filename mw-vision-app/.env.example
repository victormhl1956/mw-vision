# MW-Vision Environment Configuration
# Copy this file to .env and set your values.

# ── Local development (default) ─────────────────────────────────────────────
VITE_API_BASE=http://localhost:8000/api
VITE_WS_BASE=ws://localhost:8000

# ── Tailscale remote access ──────────────────────────────────────────────────
# Replace 100.x.x.x with your Tailscale machine IP (run: tailscale ip -4)
# VITE_API_BASE=http://100.x.x.x:8000/api
# VITE_WS_BASE=ws://100.x.x.x:8000

# ── Autenticación del WebSocket (obligatoria desde 2026-10-01) ───────────────
# El endpoint /ws rechaza conexiones sin token (código 1008). Emite uno en el
# servidor y pégalo aquí:
#   python backend/scripts/issue_ws_token.py --env
# El token caduca; la revocación no está implementada, así que mantenlo corto.
VITE_WS_TOKEN=
